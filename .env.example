# ============================================
# E-Commerce Microservices
# ============================================

APP_ENV=development

# ============================================
# User Service
# ============================================

USER_SERVICE_PORT=8081

USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_USER=postgres
USER_DB_PASSWORD=your_postgres_password
USER_DB_NAME=ecommerce_users

# ============================================
# Product Service
# ============================================

PRODUCT_SERVICE_PORT=8082

PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=your_postgres_password
PRODUCT_DB_NAME=ecommerce_products

# ============================================
# Order Service
# ============================================

ORDER_SERVICE_PORT=8083

ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=your_postgres_password
ORDER_DB_NAME=ecommerce_orders

# ============================================
# API Gateway
# ============================================

API_GATEWAY_PORT=8080

# ============================================
# Redis
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT
# ============================================

JWT_SECRET=change-this-secret
